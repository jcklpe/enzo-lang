{
  "name": "Enzo Language Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#322931",
    "editor.foreground": "#b9b5b8",
    "editorLineNumber.foreground": "#797379",
    "editorCursor.foreground": "#b9b5b8",
    "editor.selectionBackground": "#5c545b",
    "editor.lineHighlightBackground": "#79737955"
  },
  "tokenColors": [
    {
      "scope": ["constant.numeric.enzo"],
      "settings": {
        "foreground": "#fdcc59"
      }
    },
    {
      "scope": ["string.quoted.double.enzo"],
      "settings": {
        "foreground": "#8fc13e"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.enzo",
        "comment.line.test-case.enzo",
        "comment.block.enzo"
      ],
      "settings": {
        "foreground": "#797379"
      }
    },
    {
      "scope": [
        "keyword.control.flow.enzo",
        "keyword.other.or.enzo"
      ],
      "settings": {
        "foreground": "#c85e7c"
      }
    },
    {
      "scope": ["keyword.control.param.enzo"],
      "settings": {
        "foreground": "#e86f7a"
      }
    },
    {
      "scope": ["keyword.control.enzo"],
      "settings": {
        "foreground": "#149b93"
      }
    },
    {
      "scope": [
        "entity.name.function.enzo",
        "entity.name.function.definition.enzo",
        "keyword.control.return.enzo"
      ],
      "settings": {
        "foreground": "#1290bf"
      }
    },
    {
      "scope": ["entity.name.function.call.enzo"],
      "settings": {
        "foreground": "#149b93"
      }
    },
    {
      "scope": [
        "entity.name.type.blueprint.enzo",
        "punctuation.definition.blueprint.begin.enzo",
        "punctuation.definition.blueprint.end.enzo"
      ],
      "settings": {
        "foreground": "#7c5c9f"
      }
    },
    {
      "scope": [
        "entity.name.type.variant-group.enzo",
        "keyword.other.variants.enzo",
        "constant.language.status.enzo",
        "entity.name.type.reference.enzo"
      ],
      "settings": {
        "foreground": "#a45caf"
      }
    },
    {
      "scope": [
        "entity.name.type.variant.enzo"
      ],
      "settings": {
        "foreground": "#c85e7c"
      }
    },
    {
      "scope": ["constant.language.true-false.enzo"],
      "settings": {
        "foreground": "#fd8b19"
      }
    },
    {
      "scope": ["variable.parameter.blueprint.enzo"],
      "settings": {
        "foreground": "#dd464c"
      }
    },
    {
      "scope": ["entity.name.property.blueprint.enzo"],
      "settings": {
        "foreground": "#b54c6f"
      }
    },
    {
      "scope": [
        "variable.other.enzo",
        "variable.other.property.enzo"
      ],
      "settings": {
        "foreground": "#dd464c"
      }
    },
    {
      "scope": ["variable.function.call.enzo"],
      "settings": {
        "foreground": "#1a9b93"
      }
    },
    {
      "scope": ["variable.other.reference.enzo"],
      "settings": {
        "foreground": "#20a598"
      }
    },
    {
      "scope": ["support.type.number.enzo"],
      "settings": {
        "foreground": "#fdcc59"
      }
    },
    {
      "scope": ["support.type.text.enzo"],
      "settings": {
        "foreground": "#8fc13e"
      }
    },
    {
      "scope": ["support.type.list.enzo"],
      "settings": {
        "foreground": "#149b93"
      }
    },
    {
      "scope": ["support.type.function.enzo"],
      "settings": {
        "foreground": "#1290bf"
      }
    },
    {
      "scope": ["constant.language.empty.enzo"],
      "settings": {
        "foreground": "#b9b5b8"
      }
    },
    {
      "scope": [
        "keyword.operator.assignment.enzo",
        "keyword.operator.arithmetic.enzo",
        "keyword.operator.comparison.enzo"
      ],
      "settings": {
        "foreground": "#b9b5b8"
      }
    },
    {
      "scope": ["keyword.operator.reference.enzo"],
      "settings": {
        "foreground": "#dd464c"
      }
    },
    {
      "scope": ["keyword.operator.function-reference.enzo"],
      "settings": {
        "foreground": "#20a598"
      }
    },
    {
      "scope": [
        "punctuation.separator.enzo",
        "punctuation.section.brackets.enzo",
        "punctuation.section.braces.enzo",
        "punctuation.section.function.enzo"
      ],
      "settings": {
        "foreground": "#b9b5b8"
      }
    }
  ]
}
