{
  "name": "Enzo Language Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#322931",
    "editor.foreground": "#b9b5b8",
    "editorLineNumber.foreground": "#797379",
    "editorCursor.foreground": "#b9b5b8",
    "editor.selectionBackground": "#5c545b",
    "editor.lineHighlightBackground": "#79737955"
  },
  "tokenColors": [
    {
      "scope": ["constant.numeric.enzo"],
      "settings": {
        "foreground": "#fdcc59"
      }
    },
    {
      "scope": ["string.quoted.double.enzo"],
      "settings": {
        "foreground": "#8fc13e"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.enzo",
        "comment.line.test-case.enzo",
        "comment.block.enzo"
      ],
      "settings": {
        "foreground": "#797379"
      }
    },
    {
      "scope": [
        "keyword.control.flow.enzo",
        "keyword.other.or.enzo",
        "keyword.other.and.enzo"
      ],
      "settings": {
        "foreground": "#c85e7c"
      }
    },
    {
      "scope": [
        "keyword.control.param.enzo",
        "keyword.operator.destructure.enzo"
      ],
      "settings": {
        "foreground": "#e86f7a"
      }
    },
    {
      "scope": [
        "keyword.control.return.enzo",
        "entity.name.function.definition.enzo",
        "entity.name.function.enzo",
        "entity.name.function.call.enzo",
        "support.type.function.enzo"
      ],
      "settings": {
        "foreground": "#1290bf"
      }
    },
    {
      "scope": [
        "entity.name.type.blueprint.instantiation.enzo",
        "punctuation.definition.blueprint.begin.enzo",
        "punctuation.definition.blueprint.end.enzo",
        "punctuation.definition.blueprint.angle.enzo",
        "entity.name.type.blueprint.enzo"
      ],
      "settings": {
        "foreground": "#5379c1"
      }
    },
    {
      "scope": [
        "entity.name.type.variant.enzo"
      ],
      "settings": {
        "foreground": "#7c60af"
      }
    },
    {
      "scope": [
        "entity.name.type.variant-group.enzo",
        "keyword.other.variants.enzo",
        "constant.language.status.enzo"
      ],
      "settings": {
        "foreground": "#a45caf"
      }
    },
    {
      "scope": ["constant.language.true-false.enzo"],
      "settings": {
        "foreground": "#fd8b19"
      }
    },
    {
      "scope": ["entity.name.property.blueprint.enzo"],
      "settings": {
        "foreground": "#b54c6f"
      }
    },
    {
      "scope": [
        "variable.other.enzo",
        "variable.other.property.enzo",
        "variable.other.property.numeric.enzo",
        "variable.parameter.blueprint.enzo",
        "keyword.operator.reference.enzo",
        "keyword.operator.spread.begin.enzo",
        "keyword.operator.spread.end.enzo",
        "punctuation.section.embedded.begin.enzo",
        "punctuation.section.embedded.end.enzo"
      ],
      "settings": {
        "foreground": "#dd464c"
      }
    },
    {
      "scope": [
        "keyword.operator.rebind.enzo",
        "keyword.operator.immediate.enzo",
        "keyword.operator.assignment.enzo",
        "keyword.operator.append.enzo"
      ],
      "settings": {
        "foreground": "#ec8b55"
      }
    },
    {
      "scope": [
        "variable.other.reference.enzo",
        "variable.function.call.enzo",
        "support.type.list.enzo",
        "keyword.operator.function-reference.enzo",
        "keyword.control.enzo",
        "entity.name.function.property.enzo"
      ],
      "settings": {
        "foreground": "#00a3a4"
      }
    },
    {
      "scope": ["support.type.number.enzo"],
      "settings": {
        "foreground": "#fdcc59"
      }
    },
    {
      "scope": ["support.type.text.enzo"],
      "settings": {
        "foreground": "#8fc13e"
      }
    },
    {
      "scope": ["punctuation.definition.type.enzo"],
      "settings": {
        "foreground": "#ec8b55"
      }
    },
    {
      "scope": [
        "keyword.operator.arithmetic.enzo",
        "keyword.operator.comparison.enzo",
        "constant.language.empty.enzo",
        "punctuation.separator.enzo",
        "punctuation.section.brackets.enzo",
        "punctuation.section.braces.enzo",
        "punctuation.section.function.enzo"
      ],
      "settings": {
        "foreground": "#b9b5b8"
      }
    }
  ]
}
