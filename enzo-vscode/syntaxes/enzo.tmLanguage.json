{
  "scopeName": "source.enzo",
  "name": "Enzo",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-definitions"
    },
    {
      "include": "#variant-group-definitions"
    },
    {
      "include": "#variant-references"
    },
    {
      "include": "#blueprint-definitions"
    },
    {
      "include": "#blueprint-instantiation"
    },
    {
      "include": "#spread-operators"
    },
    {
      "include": "#type-checks"
    },
    {
      "include": "#property-access"
    },
    {
      "include": "#variable-references"
    },
    {
      "include": "#function-definitions"
    },
    {
      "include": "#named-functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.test-case.enzo",
          "match": "//=.*$"
        },
        {
          "name": "comment.line.double-slash.enzo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.enzo",
          "begin": "/'",
          "end": "'/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.enzo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.enzo",
              "match": "\\\\."
            },
            {
              "include": "#string-interpolation"
            }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.enzo",
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.enzo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.enzo"
            }
          },
          "patterns": [
            {
              "include": "#variables"
            },
            {
              "include": "#function-calls"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#property-access"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.enzo",
          "match": "\\b-?\\d+\\b"
        },
        {
          "name": "constant.numeric.enzo",
          "match": "\\b-?\\d+\\.\\d+\\b"
        }
      ]
    },
    "blueprint-instantiation": {
      "patterns": [
        {
          "name": "meta.variant.access.enzo",
          "match": "\\b([A-Z][a-zA-Z0-9_\\-]*)\\.([A-Z][a-zA-Z0-9_\\-]*)(?!\\s*<\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.instantiation.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\.([A-Z][a-zA-Z0-9_\\-]*)\\s*(<\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "entity.name.type.blueprint.instantiation.enzo"
            },
            "3": {
              "name": "punctuation.definition.blueprint.begin.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.instantiation.simple.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\s*(<\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.blueprint.instantiation.enzo"
            },
            "2": {
              "name": "punctuation.definition.blueprint.begin.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.instantiation.parameter.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\s*(\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.blueprint.instantiation.enzo"
            },
            "2": {
              "name": "punctuation.section.brackets.begin.enzo"
            }
          }
        },
        {
          "name": "punctuation.definition.blueprint.end.enzo",
          "match": "\\]>"
        },
        {
          "name": "meta.blueprint.property.with-type.number.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(Number)\\b",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            },
            "3": {
              "name": "support.type.number.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.with-type.text.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(Text)\\b",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            },
            "3": {
              "name": "support.type.text.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.with-type.list.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(List)\\b",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            },
            "3": {
              "name": "support.type.list.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.with-type.function.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(Function)\\b",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            },
            "3": {
              "name": "support.type.function.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.with-list-type.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(?=\\[)",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.with-function.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.with-value.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(?=\"|\\d)",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.with-type.enzo",
          "match": "([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)\\s*([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "entity.name.property.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            },
            "3": {
              "name": "entity.name.type.reference.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.property.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)(?!>)",
          "captures": {
            "1": {
              "name": "variable.parameter.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            }
          }
        }
      ]
    },
    "variant-group-definitions": {
      "patterns": [
        {
          "name": "meta.variant-group.definition.include.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\s+(variants\\s+include)\\s+([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "keyword.other.variants.enzo"
            },
            "3": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        },
        {
          "name": "meta.variant-group.definition.with-first.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\s+(variants:)\\s+([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "keyword.other.variants.enzo"
            },
            "3": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        },
        {
          "name": "meta.variant-group.definition.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\s+(variants:)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "keyword.other.variants.enzo"
            }
          }
        },
        {
          "name": "meta.variant.definition.enzo",
          "match": "\\b(and|or)\\s+([A-Z][a-zA-Z0-9_\\-]*)\\s*:",
          "captures": {
            "1": {
              "name": "keyword.other.or.enzo"
            },
            "2": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        },
        {
          "name": "meta.variant.or.enzo",
          "match": "\\b(or)\\s+([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "keyword.other.or.enzo"
            },
            "2": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        }
      ]
    },
    "variant-references": {
      "patterns": [
        {
          "name": "meta.variant-reference.conditional.enzo",
          "match": "\\b(If)\\s+([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "entity.name.type.variant-group.enzo"
            }
          }
        }
      ]
    },
    "spread-operators": {
      "patterns": [
        {
          "name": "meta.spread.enzo",
          "match": "<(?=\\$[a-zA-Z_\\-])",
          "captures": {
            "0": {
              "name": "keyword.operator.spread.begin.enzo"
            }
          }
        },
        {
          "name": "meta.spread.end.enzo",
          "match": "(?<=\\w|\\d)>(?=\\s*[,\\]])",
          "captures": {
            "0": {
              "name": "keyword.operator.spread.end.enzo"
            }
          }
        }
      ]
    },
    "blueprint-definitions": {
      "patterns": [
        {
          "name": "meta.blueprint.inheritance.parent.enzo",
          "match": "^\\s*([A-Z][a-zA-Z0-9_\\-]*)\\s*(:)\\s*([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            },
            "3": {
              "name": "entity.name.type.blueprint.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.inheritance.additional.enzo",
          "match": "\\b(and)\\s+([A-Z][a-zA-Z0-9_\\-]*)(?!\\s*<\\[)",
          "captures": {
            "1": {
              "name": "keyword.other.and.enzo"
            },
            "2": {
              "name": "entity.name.type.blueprint.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.inheritance.with-extension.enzo",
          "match": "\\b(and)\\s*(<\\[)",
          "captures": {
            "1": {
              "name": "keyword.other.and.enzo"
            },
            "2": {
              "name": "punctuation.definition.blueprint.begin.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.definition.enzo",
          "match": "^\\s*([A-Z][a-zA-Z0-9_\\-]*)\\s*(:)\\s*(<\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.blueprint.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            },
            "3": {
              "name": "punctuation.definition.blueprint.begin.enzo"
            }
          }
        }
      ]
    },
    "type-checks": {
      "patterns": [
        {
          "name": "meta.type-check.comparison.enzo",
          "match": "\\b(is\\s+(?:less\\s+than|greater\\s+than|at\\s+least|at\\s+most))\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.number.enzo",
          "match": "\\b(is)\\s+(Number)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.number.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.text.enzo",
          "match": "\\b(is)\\s+(Text)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.text.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.list.enzo",
          "match": "\\b(is)\\s+(List)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.list.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.function.enzo",
          "match": "\\b(is)\\s+(Function)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.function.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.empty.enzo",
          "match": "\\b(is)\\s+(Empty)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "constant.language.empty.enzo"
            }
          }
        }
      ]
    },
    "variable-references": {
      "patterns": [
        {
          "name": "meta.destructuring.enzo",
          "match": "(@[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(\\[\\])",
          "captures": {
            "1": {
              "name": "variable.other.reference.enzo"
            },
            "2": {
              "name": "punctuation.definition.destructuring.enzo"
            }
          }
        },
        {
          "name": "variable.other.reference.enzo",
          "match": "@[a-zA-Z_\\-][a-zA-Z0-9_\\-]*"
        }
      ]
    },
    "property-access": {
      "patterns": [
        {
          "name": "meta.property-access.function-reference.chained.enzo",
          "match": "(@)([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)((\\.[a-zA-Z_][a-zA-Z0-9_\\-]*)+)",
          "captures": {
            "1": {
              "name": "keyword.operator.function-reference.enzo"
            },
            "2": {
              "name": "variable.other.reference.enzo"
            },
            "3": {
              "name": "entity.name.function.property.enzo"
            }
          }
        },
        {
          "name": "meta.property-access.function-reference.enzo",
          "match": "@([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)(\\.)([a-zA-Z_][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "variable.other.reference.enzo"
            },
            "2": {
              "name": "punctuation.accessor.enzo"
            },
            "3": {
              "name": "entity.name.function.property.enzo"
            }
          }
        },
        {
          "name": "meta.property-access.chained.enzo",
          "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.enzo"
            },
            "2": {
              "name": "variable.other.property.enzo"
            }
          }
        },
        {
          "name": "meta.property-access.numeric-chained.enzo",
          "match": "(\\.)([0-9]+)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.enzo"
            },
            "2": {
              "name": "variable.other.property.numeric.enzo"
            }
          }
        },
        {
          "name": "meta.property-access.numeric.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)(\\.)([0-9]+)(\\.)([a-zA-Z_][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "variable.other.enzo"
            },
            "2": {
              "name": "punctuation.accessor.enzo"
            },
            "3": {
              "name": "variable.other.property.numeric.enzo"
            },
            "4": {
              "name": "punctuation.accessor.enzo"
            },
            "5": {
              "name": "variable.other.property.enzo"
            }
          }
        },
        {
          "name": "meta.property-access.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)(\\.)([a-zA-Z_][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "variable.other.enzo"
            },
            "2": {
              "name": "punctuation.accessor.enzo"
            },
            "3": {
              "name": "variable.other.property.enzo"
            }
          }
        },
        {
          "name": "meta.property-access.numeric-only.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)(\\.)([0-9]+)",
          "captures": {
            "1": {
              "name": "variable.other.enzo"
            },
            "2": {
              "name": "punctuation.accessor.enzo"
            },
            "3": {
              "name": "variable.other.property.numeric.enzo"
            }
          }
        },
        {
          "name": "constant.numeric.enzo",
          "match": "\\.\\d+"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.definition.enzo",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_\\-]*)\\s*(:)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.definition.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            }
          }
        }
      ]
    },
    "named-functions": {
      "patterns": [
        {
          "name": "meta.function.definition.enzo",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_\\-]*)\\s*(:)(?!>)",
          "captures": {
            "1": {
              "name": "entity.name.function.definition.enzo"
            },
            "2": {
              "name": "keyword.operator.assignment.enzo"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function.call.enzo",
          "match": "([a-zA-Z_][a-zA-Z0-9_\\-]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.call.enzo"
            }
          }
        },
        {
          "name": "meta.variable.function.call.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "variable.function.call.enzo"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.enzo",
          "match": "\\$[a-zA-Z_\\-0-9][a-zA-Z0-9_\\-]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.enzo",
          "match": "\\b(?:Loop|If|Else|Otherwise|until|end-loop|restart-loop|for|while|in|is|then|contains|and|or|not|either)\\b"
        },
        {
          "name": "keyword.control.return.enzo",
          "match": "\\b(?:return)\\b"
        },
        {
          "name": "keyword.control.param.enzo",
          "match": "\\b(?:param)\\b"
        },
        {
          "name": "keyword.control.enzo",
          "match": "\\b(?:end)\\b"
        },
        {
          "name": "keyword.other.blueprint.enzo",
          "match": "\\b(?:Blueprint)\\b"
        },
        {
          "name": "constant.language.status.enzo",
          "match": "\\b(?:Status)\\b"
        },
        {
          "name": "constant.language.true-false.enzo",
          "match": "\\b(?:True|False)\\b"
        },
        {
          "name": "constant.language.empty.enzo",
          "match": "\\b(?:Empty)\\b"
        },
        {
          "name": "support.type.number.enzo",
          "match": "\\b(?:Number)\\b"
        },
        {
          "name": "support.type.text.enzo",
          "match": "\\b(?:Text)\\b"
        },
        {
          "name": "support.type.list.enzo",
          "match": "\\b(?:List)\\b"
        },
        {
          "name": "support.type.function.enzo",
          "match": "\\b(?:Function)\\b"
        },
        {
          "name": "keyword.operator.word.enzo",
          "match": "\\b(?:less|than|greater|at|most|least|has)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.function-reference.enzo",
          "match": "@(?=\\()"
        },
        {
          "name": "keyword.operator.reference.enzo",
          "match": "@"
        },
