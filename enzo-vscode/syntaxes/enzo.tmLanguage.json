{
  "scopeName": "source.enzo",
  "name": "Enzo",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#blueprint-instantiation"
    },
    {
      "include": "#variant-group-definitions"
    },
    {
      "include": "#type-checks"
    },
    {
      "include": "#variable-references"
    },
    {
      "include": "#property-access"
    },
    {
      "include": "#function-definitions"
    },
    {
      "include": "#named-functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.test-case.enzo",
          "match": "//=.*$"
        },
        {
          "name": "comment.line.double-slash.enzo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.enzo",
          "begin": "/'",
          "end": "'/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.enzo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.enzo",
              "match": "\\\\."
            },
            {
              "include": "#string-interpolation"
            }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.enzo",
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.enzo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.enzo"
            }
          },
          "patterns": [
            {
              "include": "#variables"
            },
            {
              "include": "#function-calls"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#property-access"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.enzo",
          "match": "\\b-?\\d+\\b"
        },
        {
          "name": "constant.numeric.enzo",
          "match": "\\b-?\\d+\\.\\d+\\b"
        }
      ]
    },
    "blueprint-instantiation": {
      "patterns": [
        {
          "name": "meta.variant.access.enzo",
          "match": "\\b([A-Z][a-zA-Z0-9_\\-]*)\\.([A-Z][a-zA-Z0-9_\\-]*)(?!\\s*<\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.instantiation.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\.([A-Z][a-zA-Z0-9_\\-]*)\\s*(<\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "entity.name.type.blueprint.enzo"
            },
            "3": {
              "name": "punctuation.definition.blueprint.begin.enzo"
            }
          }
        },
        {
          "name": "meta.blueprint.instantiation.simple.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\s*(<\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.blueprint.enzo"
            },
            "2": {
              "name": "punctuation.definition.blueprint.begin.enzo"
            }
          }
        },
        {
          "name": "punctuation.definition.blueprint.end.enzo",
          "match": "\\]>"
        },
        {
          "name": "meta.blueprint.property.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(:)(?!>)",
          "captures": {
            "1": {
              "name": "variable.parameter.blueprint.enzo"
            },
            "2": {
              "name": "punctuation.separator.blueprint.enzo"
            }
          }
        }
      ]
    },
    "variant-group-definitions": {
      "patterns": [
        {
          "name": "meta.variant-group.definition.enzo",
          "match": "([A-Z][a-zA-Z0-9_\\-]*)\\s+(variants:)\\s+([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.variant-group.enzo"
            },
            "2": {
              "name": "keyword.other.variants.enzo"
            },
            "3": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        },
        {
          "name": "meta.variant.or.enzo",
          "match": "\\b(or)\\s+([A-Z][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "keyword.other.or.enzo"
            },
            "2": {
              "name": "entity.name.type.variant.enzo"
            }
          }
        }
      ]
    },
    "type-checks": {
      "patterns": [
        {
          "name": "meta.type-check.comparison.enzo",
          "match": "\\b(is\\s+(?:less\\s+than|greater\\s+than|at\\s+least|at\\s+most))\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.number.enzo",
          "match": "\\b(is)\\s+(Number)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.number.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.text.enzo",
          "match": "\\b(is)\\s+(Text)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.text.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.list.enzo",
          "match": "\\b(is)\\s+(List)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.list.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.function.enzo",
          "match": "\\b(is)\\s+(Function)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "support.type.function.enzo"
            }
          }
        },
        {
          "name": "meta.type-check.empty.enzo",
          "match": "\\b(is)\\s+(Empty)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.flow.enzo"
            },
            "2": {
              "name": "constant.language.empty.enzo"
            }
          }
        }
      ]
    },
    "variable-references": {
      "patterns": [
        {
          "name": "meta.destructuring.enzo",
          "match": "(@[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*(\\[\\])",
          "captures": {
            "1": {
              "name": "variable.other.reference.enzo"
            },
            "2": {
              "name": "punctuation.definition.destructuring.enzo"
            }
          }
        },
        {
          "name": "variable.other.reference.enzo",
          "match": "@[a-zA-Z_\\-][a-zA-Z0-9_\\-]*"
        }
      ]
    },
    "property-access": {
      "patterns": [
        {
          "name": "meta.property-access.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)(\\.)([a-zA-Z_][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "variable.other.enzo"
            },
            "2": {
              "name": "punctuation.accessor.enzo"
            },
            "3": {
              "name": "variable.other.property.enzo"
            }
          }
        },
        {
          "name": "constant.numeric.enzo",
          "match": "\\.\\d+"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.definition.enzo",
          "match": "([a-zA-Z_][a-zA-Z0-9_\\-]*)\\s*(:)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.enzo"
            },
            "2": {
              "name": "entity.name.function.enzo"
            }
          }
        }
      ]
    },
    "named-functions": {
      "patterns": [
        {
          "name": "meta.function.definition.enzo",
          "match": "([a-zA-Z_][a-zA-Z0-9_\\-]*)\\s*(:)(?!>)",
          "captures": {
            "1": {
              "name": "entity.name.function.enzo"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function.call.enzo",
          "match": "([a-zA-Z_][a-zA-Z0-9_\\-]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.call.enzo"
            }
          }
        },
        {
          "name": "meta.variable.function.call.enzo",
          "match": "(\\$[a-zA-Z_\\-][a-zA-Z0-9_\\-]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "variable.function.call.enzo"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.enzo",
          "match": "\\$[a-zA-Z_\\-0-9][a-zA-Z0-9_\\-]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.enzo",
          "match": "\\b(?:Loop|If|Else|Otherwise|until|end-loop|restart-loop)\\b"
        },
        {
          "name": "keyword.control.enzo",
          "match": "\\b(?:then|end|param|return|for|while|in)\\b"
        },
        {
          "name": "keyword.other.blueprint.enzo",
          "match": "\\b(?:Blueprint)\\b"
        },
        {
          "name": "constant.language.status.enzo",
          "match": "\\b(?:Status)\\b"
        },
        {
          "name": "constant.language.true-false.enzo",
          "match": "\\b(?:True|False)\\b"
        },
        {
          "name": "constant.language.empty.enzo",
          "match": "\\b(?:Empty)\\b"
        },
        {
          "name": "support.type.number.enzo",
          "match": "\\b(?:Number)\\b"
        },
        {
          "name": "support.type.text.enzo",
          "match": "\\b(?:Text)\\b"
        },
        {
          "name": "support.type.list.enzo",
          "match": "\\b(?:List)\\b"
        },
        {
          "name": "support.type.function.enzo",
          "match": "\\b(?:Function)\\b"
        },
        {
          "name": "keyword.operator.word.enzo",
          "match": "\\b(?:is|less|than|greater|at|most|least|contains|has|and|or|not)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.reference.enzo",
          "match": "@"
        },
        {
          "name": "keyword.operator.invocation.enzo",
          "match": "!"
        },
        {
          "name": "keyword.operator.assignment.enzo",
          "match": "(<:|:>|:)"
        },
        {
          "name": "keyword.operator.arithmetic.enzo",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.enzo",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.enzo",
          "match": "[;,]"
        },
        {
          "name": "punctuation.section.brackets.enzo",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.enzo",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.section.function.enzo",
          "match": "[\\(\\)]"
        }
      ]
    }
  }
}
