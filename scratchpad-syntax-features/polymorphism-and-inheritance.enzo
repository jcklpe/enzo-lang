//Inheritance via interpolated extension and polymorphic overrides
Animal: <[
  name: Text,
  speak: ()
]>;

// Interpolate + override = inferred Dog child of Animal
Dog: <[
  <Animal>,                 // basis for subtyping
  name: "Rover",            // width extension is fine
  speak: ( "Woof!" )        // override must be type-compatible
]>;

// open extension (rebinding) adds an id & refines speak
Dog <: <[
  <Dog>,
  id: "DOG-001",
  speak: ( "WOOF!!" )   /' must remain compatible with Animal.speak '/
]>;

// variant group via interpolation
Core-Enemies variants: Goblin or Orc;
Bosses variants: Dragon or Lich;

Enemy variants: <Core-Enemies> or <Bosses>;

// open extension for Blueprint variant groups, this would replace existing `include` syntax
Status variants <: <Status> or Loading or Dead;

// potential override conflict resolved by list order
Can-Speak: <[ speak: () ]>;

Dog <: <[
  <Dog>,
  <Can-Speak>,          /' harmless if already present; you still control the final value '/
  speak: ( "Woof!" ) // this overrides both Dog and Can-Speak
]>;
>>>>>>>>>>>>>>>>]]]]]]]]]]]]]

// Blueprint inheritance and composition via interpolation

Animal: <[
    position: [Number, Number, Number],
    name: ""
    say-name: (
      return("Hi my name is <$self.name>");
    )
]>;

Flying: <[
    wings: "true",
    fly: (
        param $height: 10;
        return("Flying at height <$height>");
    )
]>;

Swimming: <[
    fins: "true",
    swim: (
        $water-speed: Number,
        return("Swimming at speed of <$water-speed>");
    )
]>;

Duck: <[
  <Animal>,
  <Flying>,
  <Swimming>
]>

// Combining two blueprints
Duck: Animal and Flying-Animal and Swimming-Animal;

// more examples of Blueprint composition via interpolation:
Humanoid:       <[ tool-use: "true", locomotion: "bipedal" ]>;
Night-Creature: <[ dark-vision: "true" ]>;
Small:          <[ size: "small" ]>;

Goblin: <[
  <Humanoid>,
  <Night-Creature>,
  <Small>,
  hp: 100,
  has-dagger: "true"
]>;
// Precedence rule (simple and predictable): last write wins. If both <Humanoid> and <Small> had size, the later one in the list wins.

// allow renaming similar to destructuring:
Aquatic: <[ speed: 20, move: ( "swims <self.speed> units" ) ]>;
Land:    <[ speed: 10, move: ( "walks <self.speed> units" ) ]>;

Amphibian: <[
  <Aquatic>,
  move->swim,    // keep both behaviors under different names
  speed->water-speed,
  <Land>,
  move->walk,
  speed->land-speed
]>;

$frog: Amphibian[];
$frog.swim; // returns "swims 20 units"
$frog.walk; // returns "swims 10 units"
$frog; /' returns
[
  $water-speed: 20,
  swim: ("swims <self.speed> units"),
  $land-speed: 10,
  swim: ("walks <self.speed> units"),
]
'/
// does this renaming stuff make it potentially difficult to trace parent functions?

// notes on how subtyping should work
make-it-talk: (param $a: Animal; $a.speak());
make-it-talk($Dog);  // works because Dog includes <Animal>



// Scratch notes
//- random idea for conditional composition:
$hard-mode: "true";

Goblin: <[
  <Humanoid>,
  <Night-Creature>,
  hp: 100,
  If $hard-mode, (<[ rage: 25 ]>)
]>;

//- parameterized Blueprint variant groups:
Make-Slime: (
  param $color: "green";
  Slime-<$color>: <[ hp: 30, color: $color ]>
);

// Expand into named variants
Slime variants: <[
  <Make-Slime("green")>,
  <Make-Slime("red")>
]>;

//- interesting idea about computing/interpolating base Blueprints
Scale-Stats: (
  param $pack: [];
  param $mult: 1;
  <[
    hp: $pack.hp * $mult,
    damage: $pack.damage * $mult
  ]>
);

Base-Stats: <[ hp: 50, damage: 7 ]>;

Goblin: <[
  <Humanoid>,
  <Base-Stats then Scale-Stats($this, 2)>,  /' hp=100, damage=14 '/
]>;

//- Interpolation open extension
// use this instead of includes for open extension
Status variants <: <Status> or Loading or Dead;

// use this instead of implements
Can-Speak: <[ speak: ()]>;
Dog<: <Dog> and Can-Speak as <[
  speak: ( "Woof!" )
]>;

//- more scratch
// alternative interpolation approach (uses curly braces because too many angle brackets otherwise)
Dog: {[
  <Animal> as {[speak:(say("Woof!"))]},
]};

//- extends syntax  polymorphism using inheritance overrides for implementation details. (single-dispatch polymorphism)
Animal: <[ speak:() ]>;
Dog extends Animal: <[ speak: ( say("Woof!") ); ]>;
Cat extends Animal: <[ speak: ( say("Meow!") ); ]>;

// composing in Function implementation without hierarchy
Can-Speak: <[ speak: () ]>;

Animal: <[
    name: Text,
    location: [Number, Number, Number]
]>;

// Compose together Blueprints and specify implementation overrides
Dog: Animal as <[ name: "Rover" ]> and Can-Speak as <[
  speak: ( "Woof!" )
]>;

Cat: Animal as <[ name: "Mittens" ]> and Can-Speak as <[
  speak: ( "Meow!" )
]>;
//"open extension" of Function implementation without having to edit subclass definition
Can-Speak: <[ speak: ()]>;
Dog implements Can-Speak: <[
  speak: ( "Woof!" )
]>;
