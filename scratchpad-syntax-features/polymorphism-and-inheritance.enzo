If $score is greater than 90, (
    "Excellent!";
);
Else if $age is at least 18 and at most 65, (
    "Working age";
);
Else, ("Else fallback");


// By default, everything is copy-by-value
$original: [1, 2, 3];
$copy: $original;
$copy.1 <: 999;
$original;  // Still [1, 2, 3]
$copy;      // Now [999, 2, 3]

// Use @ for references
$ref: @original;
$ref.1 <: 777;
$original;  // Now [777, 2, 3]
$ref;       // Also [777, 2, 3]
