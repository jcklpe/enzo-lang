//= consecutive Function atoms
(4+4); (5+6); // prints 8 then 11

//= Conditionals
$score: 95;
$weather: "sunny";
$age: 25;
$items-misc: ["apple", "banana", "cherry"];

// Basic conditions
If $score is greater than 90, (
    "Excellent!";
);

// If-else
If $weather is "rainy", (
    "Bring umbrella";
), Else, (
    "No umbrella needed";
);

// Comparison operators lightning round
If $age is less than 18, (
    "Minor";
);

If $score is at least 85, (
    "Honor roll";
);

If $age is at least 18 and at most 65, (
    "Working age";
);

// Multi-branch checks (switch-like) with pattern matching
$user_input: "banana";

If $user_input either is Number, (
    "Got a number: <$user_input>";
),
or contains "apple", (
    "Something with apple";
),
or is "banana", (
    "Exact banana match";
),
or is greater than 100, (
    "Big number";
),
Otherwise, (
    "Something else entirely";
);

// Pattern matching with lists
$data-misc: [1, "test", 3];

If $data-misc either contains "test", (
    "Found test string";
),
or is [1, 2, 3], (
    "Exact number sequence";
),
or contains Number, (
    "Contains numbers";
),
Otherwise, (
    "No pattern matched";
);

//= Divide by zero bug
// Student grading system
Student: <[
    name: "Unknown",
    scores: [],
    calculate_average: (
        $total: 0;
        $count: 0;
        Loop for $score in $self.scores, (
            $total + $score :> $total;
            $count + 1 :> $count;
        );
        return($total / $count);
    ),
    get_grade: (
        $avg: $self.calculate_average();
        If $avg is greater than 90, (
            return("A");
        ), Else if $avg is greater than 80, (
            return("B");
        ), Else if $avg is greater than 70, (
            return("C");
        ), Else, (
            return("F");
        );
    )
]>;

// Create students
$alice: Student[
    $name: "Alice",
    $scores: [95, 87, 92, 89]
];

$bob: Student[
    $name: "Bob",
    $scores: [76, 82, 79, 85]
];

// Process results with pipelines
$alice.get_grade()
    then ("Student <$alice.name> earned grade: <$this>")
    then ("<$this> (Average: <$alice.calculate_average()>)");

//= Nested rebinding behavior bug
// Test case for rebinding operators inside If statements
// This currently fails due to scoping bug where rebinding inside
// conditional blocks doesn't propagate to outer scope

// Test 1: Simple rebinding with <:
$test_rebind_simple: False;
$test_rebind_simple; // returns False

If 64 is greater than 34, (
    $test_rebind_simple <: True;
);
$test_rebind_simple; //returns True

// Test 2: Nested If rebinding (bubble sort pattern)
$test_rebind_nested: False;
$order: "ascending";
$test_rebind_nested; // returns False

If $order is "ascending", (
    If 64 is greater than 34, (
        $test_rebind_nested <: True;
    );
);
$test_rebind_nested; // returns True

// Test 3: Compare with working Loop rebinding
$test_loop_rebind: 0;
$test_loop_rebind;  // returns 0

$numbers-misc: [1, 2, 3];
Loop for $num in $numbers-misc, (
    $test_loop_rebind + $num :> $test_loop_rebind;
);
$test_loop_rebind;  // returns 6

//= Arbitrarily deep nested scope
// Test 6-level nesting with mixed function types
$deep_test: "original";
$deep_test; // returns "original"

If True, (
    "Level1-If";  // returns "Level1-If"
    ($x: 1; // Level2-Function
        Loop for $i in [1], ( // Level3-Loop
            If True, ( // Level4-If
                ($y: 2; // Level5-Function
                    If True, ( // Level6-If
                        $deep_test <: "6levels_mixed";
                        "testing interior: <$deep_test;>";
                    );
                );
            );
        );
    );
);
$deep_test; // returns "6levels_mixed"

// Test 10-level nesting pure conditionals
$deep_test2: "original2";
$deep_test2;  // returns "original2"

If True, (
    If True, (
        If True, (
            If True, (
                If True, (
                    If True, (
                        If True, (
                            If True, (
                                If True, (
                                    If True, (
                                        $deep_test2 <: "10levels_if";
                                    );
                                );
                            );
                        );
                    );
                );
            );
        );
    );
);
$deep_test2;  // returns "10levels_if"

// Test 8-level nesting pure functions
$deep_test3: "original3";
$deep_test3;  // returns "original3"

($a: 1;
    ($b: 2;
        ($c: 3;
            ($d: 4;
                ($e: 5;
                    ($f: 6;
                        ($g: 7;
                            ($h: 8;
                                $deep_test3 <: "8levels_func";
                            );
                        );
                    );
                );
            );
        );
    );
);
$deep_test3;  // returns "8levels_func"

// Test 7-level nesting pure loops
$deep_test4: 0;
$deep_test4;  // returns 0

$ones: [1];
Loop for $a in $ones, (
    Loop for $b in $ones, (
        Loop for $c in $ones, (
            Loop for $d in $ones, (
                Loop for $e in $ones, (
                    Loop for $f in $ones, (
                        Loop for $g in $ones, (
                            $deep_test4 + 1 :> $deep_test4;
                        );
                    );
                );
            );
        );
    );
);
$deep_test4;  // returns 1

//= PASSING BY VALUE (COPY) - DEFAULT BEHAVIOR
$original-copy: [1, 2, 3];

modify-copy: (
    param $list: ;
    $list.1 <: 99;
    $list;  // show modified copy
);

modify-copy($original-copy);  // passes a copy
$original-copy;  // should still be [1, 2, 3]

//= PASSING BY REFERENCE - EXPLICIT WITH @
$original-ref: [1, 2, 3];

modify-reference: (
    param $list: ;
    $list.1 <: 99;
    $list;  // show modified reference
);

modify-reference(@original-ref);  // passes reference
$original-ref;  // should now be [99, 2, 3] - modified!

//= PARAMETER DEFAULT DOESN'T CHANGE REFERENCE BEHAVIOR
$original-with-default: [1, 2, 3];

modify-with-default: (
    param $list: [];  // has default value
    $list.1 <: 99;
);

modify-with-default(@original-with-default);  // still modifies original
$original-with-default;  // should be [99, 2, 3]

//= PASSING REFERENCE TO NESTED STRUCTURE
$nested-original-1: [$inner: [10, 20, 30]];

modify-nested: (
    param $data: ;
    $data.inner.2 <: 999;
);

modify-nested(@nested-original-1);
$nested-original-1;  // should be [$inner: [10, 999, 30]]

//= LIST OF REFERENCES
$list1: [1, 2, 3];
$list2: [4, 5, 6];

batch-modify: (
    param $lists: ;
    $lists.1.1 <: 99;  // modify first list's first element
    $lists.2.1 <: 88;  // modify second list's first element
);

batch-modify([@list1, @list2]);  // pass references in a list
$list1;  // should be [99, 2, 3]
$list2;  // should be [88, 5, 6]

//= MIXED COPY AND REFERENCE IN SAME CALL
$ref-item: [100, 200];
$copy-item: [300, 400];

mixed-modify: (
    param $ref-param: ;
    param $copy-param: ;
    $ref-param.1 <: 111;
    $copy-param.1 <: 333;
);

mixed-modify(@ref-item, $copy-item);
$ref-item;   // should be [111, 200] - modified
$copy-item;  // should be [300, 400] - unchanged

//= STORING REFERENCE IN VARIABLE THEN PASSING
$data-1: [7, 8, 9];
$data-ref: @data-1;

modify-stored-ref: (
    param $item: ;
    $item.1 <: 777;
);

modify-stored-ref($data-ref);  // pass the stored reference
$data-1;  // should be [777, 8, 9] - modified through stored reference
