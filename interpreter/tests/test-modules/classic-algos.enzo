//= BUBBLE SORT

// Helper function to get list length
get-length: (
    param $list: [];
    $count: 0;
    Loop for $item in $list, (
        $count + 1 :> $count;
    );
    return($count);
);

// Helper function to swap two elements using list interpolation
swap-at-positions: (
    param $list: [];
    param $pos1: 1;
    param $pos2: 2;

    // Use list interpolation to rebuild the list with swapped elements
    $before-pos1: [];
    $between: [];
    $after-pos2: [];

    // Build sections of the list
    $index: 1;
    Loop for $item in $list, (
        If $index is less than $pos1, (
            $before-pos1<: [<$before-pos1>, $item];
        );
        If $index is greater than $pos1 and $index is less than $pos2, (
            $between<: [<$between>, $item];
        );
        If $index is greater than $pos2, (
            $after-pos2<: [<$after-pos2>, $item];
        );
        $index + 1 :> $index;
    );

    // Rebuild with swapped elements
    $new-list: [<$before-pos1>, $list.$pos2, <$between>, $list.$pos1, <$after-pos2>];
    return($new-list);
);

// Much simpler bubble sort - just one pass at a time with simple swaps
bubble-sort: (
    param $list: [];
    param $order: "ascending";

    $length: $get-length($list);
    If $length is less than 2, (
        return($list);
    );

    $current-list: $list;
    $pass: 1;

    // Do multiple passes
    Loop while $pass is less than $length, (
        $position: 1;

        // One pass through the list
        Loop while $position is less than $length, (
            $current-elem: $current-list.$position;
            $next-elem: $current-list.($position + 1);

            $should-swap: False;
            If $order is "ascending", (
                If $current-elem is greater than $next-elem, (
                    $should-swap <: True;
                );
            ), Else if $order is "descending", (
                If $current-elem is less than $next-elem, (
                    $should-swap <: True;
                );
            );

            If $should-swap, (
                // Simple swap by rebuilding entire list
                $new-list: [];
                $rebuild-pos: 1;

                Loop while $rebuild-pos is at most $length, (
                    If $rebuild-pos is $position, (
                        $new-list <: [<$new-list>, $next-elem];
                    ), Else if $rebuild-pos is ($position + 1), (
                        $new-list <: [<$new-list>, $current-elem];
                    ), Else, (
                        $elem: $current-list.$rebuild-pos;
                        $new-list <: [<$new-list>, $elem];
                    );
                    $rebuild-pos + 1 :> $rebuild-pos;
                );

                $new-list :> $current-list;
            );

            $position + 1 :> $position;
        );

        $pass + 1 :> $pass;
    );

    return($current-list);
);

//= Test with unsorted numbers (ascending)
$numbers: [64, 34, 25, 12, 22, 11, 90];
$bubble-sort($numbers, "ascending") :> $numbers;
$numbers;

//= Test with unsorted numbers (descending)
$numbers2: [64, 34, 25, 12, 22, 11, 90];
$bubble-sort($numbers2, "descending") :> $numbers2;
$numbers2;

//= Test empty list
$empty: [];
$bubble-sort($empty, "ascending") :> $empty;
$empty;

//= Test single element
$single: [42];
$bubble-sort($single, "ascending") :> $single;
$single;

//= Test already sorted list
$sorted: [1, 2, 3, 4, 5];
$bubble-sort($sorted, "ascending") :> $sorted;
$sorted;

//= Test reverse sorted list
$reverse: [5, 4, 3, 2, 1];
$bubble-sort($reverse, "ascending") :> $reverse;
$reverse;

//= Test with duplicate values
$duplicates: [3, 1, 4, 1, 5, 9, 2, 6, 5];
$bubble-sort($duplicates, "ascending") :> $duplicates;
$duplicates;
